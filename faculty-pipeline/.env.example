# Copy to .env and adjust. See docs/FACULTY_PIPELINE.md §10.

# Used by services/llm.py (Milestones 3, 5). Already set in this environment.
ANTHROPIC_API_KEY=

# No search API key is configured for this project (see the adaptation
# banner at the top of docs/FACULTY_PIPELINE.md). Leaving this unset — and
# leaving search_provider unset in config/pipeline.yaml — makes
# services/search.py degrade to returning no candidates, never raising.
SEARCH_API_KEY=
