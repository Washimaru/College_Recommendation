{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unimatch.dev/contracts/score.schema.json",
  "title": "RankRequest",
  "version": "3.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "universities"],
  "properties": {
    "profile": { "$ref": "profile.schema.json" },
    "weight_feedback": {
      "type": "object",
      "description": "Multiplicative adjustments to weights, pre-clamped by the recommendation loop to [0.5, 1.5].",
      "additionalProperties": { "type": "number" },
      "default": {}
    },
    "universities": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/University" }
    }
  },
  "$defs": {
    "University": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "country", "avg_gpa", "size", "location", "majors", "culture"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Slug of the name; uniform across US and non-US schools." },
        "unitid": { "type": ["string", "null"], "description": "Federal IPEDS UNITID where matched. US only." },
        "name": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "minLength": 1, "description": "Gates whether US federal enrichment can apply." },
        "location": { "type": "string" },
        "avg_gpa": { "type": "number", "minimum": 0, "maximum": 4.0 },
        "avg_sat": { "type": ["integer", "null"], "minimum": 400, "maximum": 1600, "description": "Observed only. Never derived from GPA." },
        "acceptance_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "net_price": { "type": ["number", "null"], "minimum": 0, "description": "Average annual cost after aid. Renamed from `tuition` in v2.0.0, which conflated net cost with sticker price." },
        "sticker_tuition": { "type": ["number", "null"], "minimum": 0 },
        "enrollment": { "type": ["integer", "null"], "minimum": 0, "description": "Undergraduate only, to stay comparable across sources." },
        "size": { "type": "string", "enum": ["small", "medium", "large"] },
        "majors": { "type": "array", "items": { "type": "string" } },
        "culture": {
          "type": "object",
          "additionalProperties": false,
          "description": "Six bipolar axes, aligned with Profile.culture_prefs. Required: it drives 20% of the score.",
          "required": ["collab", "quirky", "idealist", "research", "spirit", "seminar"],
          "properties": {
            "collab": { "type": "number", "minimum": 0, "maximum": 1 },
            "quirky": { "type": "number", "minimum": 0, "maximum": 1 },
            "idealist": { "type": "number", "minimum": 0, "maximum": 1 },
            "research": { "type": "number", "minimum": 0, "maximum": 1 },
            "spirit": { "type": "number", "minimum": 0, "maximum": 1 },
            "seminar": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "details": {
          "type": ["object", "null"],
          "description": "Curated per-school profile (scholarships, research, outcomes, graduate and professional schools). Free-form because sections are heterogeneous. Null when no profile exists - never generated filler. provenance.details records the tier.",
          "default": null
        },
        "provenance": {
          "type": "object",
          "description": "Per-field origin: observed | web_verified | editorial | not_applicable | absent.",
          "additionalProperties": { "type": "string", "enum": ["observed", "web_verified", "editorial", "not_applicable", "absent"] },
          "default": {}
        }
      }
    },
    "ScoredUniversity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["university_id", "score", "components"],
      "properties": {
        "university_id": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "components": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "RankResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scores"],
      "properties": {
        "scores": {
          "type": "array",
          "description": "Sorted by descending score, then ascending university_id.",
          "items": { "$ref": "#/$defs/ScoredUniversity" }
        }
      }
    }
  }
}
