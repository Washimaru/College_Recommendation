{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unimatch.dev/contracts/score.schema.json",
  "title": "RankRequest",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "universities"],
  "properties": {
    "profile": { "$ref": "profile.schema.json" },
    "weight_feedback": {
      "type": "object",
      "description": "Multiplicative adjustments to weights, pre-clamped by the recommendation loop to [0.5, 1.5].",
      "additionalProperties": { "type": "number" },
      "default": {}
    },
    "universities": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/University" }
    }
  },
  "$defs": {
    "University": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "avg_gpa", "avg_sat", "acceptance_rate", "tuition", "size", "location", "majors"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "avg_gpa": { "type": "number", "minimum": 0, "maximum": 4.0 },
        "avg_sat": { "type": "integer", "minimum": 400, "maximum": 1600 },
        "acceptance_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "tuition": { "type": "number", "minimum": 0 },
        "size": { "type": "string", "enum": ["small", "medium", "large"] },
        "location": { "type": "string" },
        "majors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ScoredUniversity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["university_id", "score", "components"],
      "properties": {
        "university_id": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "components": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "RankResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scores"],
      "properties": {
        "scores": {
          "type": "array",
          "description": "Sorted by descending score, then ascending university_id.",
          "items": { "$ref": "#/$defs/ScoredUniversity" }
        }
      }
    }
  }
}
