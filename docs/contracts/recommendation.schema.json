{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unimatch.dev/contracts/recommendation.schema.json",
  "title": "RecommendationResponse",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["results", "confidence", "stop_reason", "trace"],
  "properties": {
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/Result" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "stop_reason": { "type": "string", "enum": ["R1_converged", "R2_confident", "R3_no_change", "R4_iteration_cap"] },
    "trace": {
      "type": "array",
      "items": { "$ref": "#/$defs/TraceStep" }
    }
  },
  "$defs": {
    "RecommendationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": { "$ref": "profile.schema.json" },
        "max_iterations": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 },
        "top_k": { "type": "integer", "minimum": 1, "maximum": 50, "default": 5 }
      }
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["university_id", "name", "score", "rationale"],
      "properties": {
        "university_id": { "type": "string" },
        "name": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string" }
      }
    },
    "TraceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iteration", "top_ids", "confidence", "stop_reason"],
      "properties": {
        "iteration": { "type": "integer", "minimum": 0 },
        "top_ids": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "stop_reason": { "type": ["string", "null"] }
      }
    }
  }
}
