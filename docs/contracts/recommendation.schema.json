{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unimatch.dev/contracts/recommendation.schema.json",
  "title": "RecommendationResponse",
  "version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["results", "confidence", "stop_reason", "trace"],
  "properties": {
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/Result" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "stop_reason": { "type": "string", "enum": ["R1_converged", "R2_confident", "R3_no_change", "R4_iteration_cap"] },
    "trace": {
      "type": "array",
      "items": { "$ref": "#/$defs/TraceStep" }
    }
  },
  "$defs": {
    "RecommendationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": { "$ref": "profile.schema.json" },
        "max_iterations": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 },
        "top_k": { "type": "integer", "minimum": 1, "maximum": 50, "default": 5 }
      }
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["university_id", "name", "score", "rationale", "university"],
      "properties": {
        "university_id": { "type": "string" },
        "name": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string" },
        "admit_tier": {
          "type": ["string", "null"],
          "enum": ["reach", "target", "safety", null],
          "description": "Computed server-side from avg_gpa minus the student's GPA, boundary 0.12 either side. Null when the student gave no GPA."
        },
        "university": { "$ref": "#/$defs/UniversitySummary" }
      }
    },
    "UniversitySummary": {
      "type": "object",
      "additionalProperties": false,
      "description": "Enough of the university for a client to show why it is listed and how trustworthy each figure is.",
      "required": ["country", "location", "avg_gpa", "size", "culture"],
      "properties": {
        "country": { "type": "string" },
        "location": { "type": "string" },
        "avg_gpa": { "type": "number", "minimum": 0, "maximum": 4.0 },
        "avg_sat": { "type": ["integer", "null"], "minimum": 400, "maximum": 1600 },
        "acceptance_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "net_price": { "type": ["number", "null"], "minimum": 0 },
        "enrollment": { "type": ["integer", "null"], "minimum": 0 },
        "size": { "type": "string", "enum": ["small", "medium", "large"] },
        "majors": { "type": "array", "items": { "type": "string" } },
        "culture": {
          "type": "object",
          "additionalProperties": false,
          "description": "Six bipolar axes, aligned with Profile.culture_prefs.",
          "required": ["collab", "quirky", "idealist", "research", "spirit", "seminar"],
          "properties": {
            "collab": { "type": "number", "minimum": 0, "maximum": 1 },
            "quirky": { "type": "number", "minimum": 0, "maximum": 1 },
            "idealist": { "type": "number", "minimum": 0, "maximum": 1 },
            "research": { "type": "number", "minimum": 0, "maximum": 1 },
            "spirit": { "type": "number", "minimum": 0, "maximum": 1 },
            "seminar": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "provenance": {
          "type": "object",
          "description": "Per-field origin. A null with provenance not_applicable must not render the same as absent.",
          "additionalProperties": { "type": "string", "enum": ["observed", "web_verified", "editorial", "not_applicable", "absent"] },
          "default": {}
        }
      }
    },
    "TraceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iteration", "top_ids", "confidence", "stop_reason"],
      "properties": {
        "iteration": { "type": "integer", "minimum": 0 },
        "top_ids": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "stop_reason": { "type": ["string", "null"] }
      }
    }
  }
}
