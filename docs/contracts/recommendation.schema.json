{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unimatch.dev/contracts/recommendation.schema.json",
  "title": "RecommendationResponse",
  "version": "9.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["results", "confidence", "stop_reason", "trace"],
  "properties": {
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/Result" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "stop_reason": { "type": "string", "enum": ["R1_converged", "R2_confident", "R3_no_change", "R4_iteration_cap"] },
    "trace": {
      "type": "array",
      "items": { "$ref": "#/$defs/TraceStep" }
    }
  },
  "$defs": {
    "RecommendationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": { "$ref": "profile.schema.json" },
        "max_iterations": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 },
        "top_k": { "type": "integer", "minimum": 1, "maximum": 50, "default": 5 }
      }
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["university_id", "name", "score", "rationale", "university"],
      "properties": {
        "university_id": { "type": "string" },
        "name": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string" },
        "admit_tier": {
          "type": ["string", "null"],
          "enum": ["extreme_reach", "reach", "target", "safety", null],
          "description": "Computed server-side. extreme_reach fires first when acceptance_rate is not null and <= 0.15 (a stated judgement, not a measured finding); otherwise reach/target/safety come from avg_gpa minus the student's GPA, boundary 0.12 either side. A null acceptance_rate never produces extreme_reach - it falls through to the GPA rule. Null admit_tier when the student gave no GPA."
        },
        "university": { "$ref": "#/$defs/UniversitySummary" }
      }
    },
    "UniversitySummary": {
      "type": "object",
      "additionalProperties": false,
      "description": "Enough of the university for a client to show why it is listed and how trustworthy each figure is.",
      "required": ["country", "location", "avg_gpa", "size", "culture", "region", "setting", "type"],
      "properties": {
        "country": { "type": "string" },
        "location": { "type": "string" },
        "state": { "type": ["string", "null"], "minLength": 2, "maxLength": 2, "description": "Two-letter US state code, from Scorecard STABBR. US only; null and provenance not_applicable elsewhere. Structured on purpose: `location` is display-only, so residency must never be decided by parsing it." },
        "region": { "type": "string", "enum": ["Northeast", "South", "West", "Midwest", "International"] },
        "setting": { "type": "string", "enum": ["urban", "suburban", "rural"] },
        "type": { "type": "string", "enum": ["Public", "Private"] },
        "population": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "description": "Student-body composition. Null for non-US schools; provenance.population reads not_applicable.",
          "properties": {
            "international_share": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "women_share": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "first_gen_share": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
          }
        },
        "url": { "type": ["string", "null"], "description": "The institution's own site." },
        "net_price_calculator_url": { "type": ["string", "null"], "description": "Where a student finds what they specifically would pay." },
        "avg_gpa": { "type": "number", "minimum": 0, "maximum": 4.0 },
        "avg_sat": { "type": ["integer", "null"], "minimum": 400, "maximum": 1600 },
        "acceptance_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "net_price": { "type": ["number", "null"], "minimum": 0 },
        "tuition_in_state": { "type": ["number", "null"], "minimum": 0, "description": "In-state tuition and fees. US only; null and provenance not_applicable elsewhere." },
        "notable_faculty": {
          "type": ["array", "null"],
          "description": "Named professors, most widely known first. Null means nobody searched (every non-US school); [] means searched and none found, which is a real answer for a small college. Carries who someone is and where to verify it - never an email or a phone number. Sourced from Wikipedia category membership plus Wikidata, so no model is involved and a professor cannot be invented.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "source", "source_url"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "known_for": { "type": ["string", "null"], "description": "One line on who they are, e.g. 'American theoretical physicist'." },
              "fields": { "type": "array", "items": { "type": "string" }, "description": "Occupations, e.g. ['physicist', 'author']. Generic academic occupations are dropped as uninformative." },
              "status": { "type": "string", "enum": ["current", "historical"], "description": "historical means a recorded date of death - the person belongs in the school's story but is not teaching. Absence of a death date is not proof of tenure, which is why the values are not 'alive'/'dead'." },
              "prominence": { "type": "integer", "minimum": 0, "description": "How many language Wikipedias carry an article. A measured proxy for renown, not a judgement." },
              "source": { "type": "string", "enum": ["wikipedia", "directory"] },
              "source_url": { "type": "string", "minLength": 1 }
            }
          }
        },
        "programs": {
          "type": ["array", "null"],
          "description": "Share of degrees actually awarded by 2-digit CIP family, largest first. Null means unmeasured; [] means measured and awarding none of these.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "share"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "share": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "enrollment": { "type": ["integer", "null"], "minimum": 0 },
        "size": { "type": "string", "enum": ["small", "medium", "large"] },
        "majors": { "type": "array", "items": { "type": "string" } },
        "culture": {
          "type": "object",
          "additionalProperties": false,
          "description": "Six bipolar axes, aligned with Profile.culture_prefs.",
          "required": ["collab", "quirky", "idealist", "research", "spirit", "seminar"],
          "properties": {
            "collab": { "type": "number", "minimum": 0, "maximum": 1 },
            "quirky": { "type": "number", "minimum": 0, "maximum": 1 },
            "idealist": { "type": "number", "minimum": 0, "maximum": 1 },
            "research": { "type": "number", "minimum": 0, "maximum": 1 },
            "spirit": { "type": "number", "minimum": 0, "maximum": 1 },
            "seminar": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "details": {
          "type": ["object", "null"],
          "description": "Curated per-school profile, or null when none exists.",
          "default": null
        },
        "provenance": {
          "type": "object",
          "description": "Per-field origin. A null with provenance not_applicable must not render the same as absent.",
          "additionalProperties": { "type": "string", "enum": ["observed", "web_verified", "editorial", "not_applicable", "absent"] },
          "default": {}
        }
      }
    },
    "TraceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iteration", "top_ids", "confidence", "stop_reason"],
      "properties": {
        "iteration": { "type": "integer", "minimum": 0 },
        "top_ids": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "stop_reason": { "type": ["string", "null"] }
      }
    }
  }
}
