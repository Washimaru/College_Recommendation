{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unimatch.dev/contracts/profile.schema.json",
  "title": "StudentProfile",
  "version": "3.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["gpa", "intended_major"],
  "properties": {
    "gpa": { "type": "number", "minimum": 0, "maximum": 4.0 },
    "sat": { "type": ["integer", "null"], "minimum": 400, "maximum": 1600 },
    "intended_major": { "type": "string", "minLength": 1 },
    "culture_prefs": {
      "type": "object",
      "additionalProperties": false,
      "description": "Self-reported preference on six bipolar axes. 0.5 means indifferent. Replaces the MBTI-derived personality dimension removed in v2.0.0.",
      "properties": {
        "collab": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "quirky": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "idealist": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "research": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "spirit": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "seminar": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 }
      },
      "default": {}
    },
    "personality": {
      "type": "object",
      "additionalProperties": false,
      "description": "Derived from the questionnaire, on axes the culture vector does not cover so no signal is scored twice. 0.5 means no preference.",
      "properties": {
        "intensity": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5, "description": "0 = steady and low-pressure, 1 = driven and highly competitive." },
        "scale": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5, "description": "0 = small and close-knit, 1 = large and bustling." }
      },
      "default": {}
    },
    "activities": {
      "type": "array",
      "description": "Competitions, clubs and other commitments, matched by keyword against what a school is strong in.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["competition", "club", "volunteering", "work", "sport", "arts", "research", "other"], "default": "other" },
          "years": { "type": ["integer", "null"], "minimum": 0, "maximum": 12 }
        }
      },
      "default": []
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tuition": { "type": ["number", "null"], "minimum": 0 },
        "preferred_size": { "type": ["string", "null"], "enum": ["small", "medium", "large", null] },
        "locations": { "type": "array", "items": { "type": "string" }, "default": [] },
        "scope": { "type": "string", "enum": ["usa", "international", "both"], "default": "both", "description": "Country scope. A hard filter applied at candidate selection, not a ranking signal, so a requested top_k is still filled." }
      },
      "default": {}
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional per-request overrides of the default scoring weights.",
      "properties": {
        "academic": { "type": "number", "minimum": 0 },
        "cost": { "type": "number", "minimum": 0 },
        "fit": { "type": "number", "minimum": 0 },
        "culture": { "type": "number", "minimum": 0 },
        "activities": { "type": "number", "minimum": 0 },
        "personality": { "type": "number", "minimum": 0 }
      }
    }
  }
}
